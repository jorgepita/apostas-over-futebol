# Template for local development only — copy to .env and fill in real
# values there. .env is gitignored (see .gitignore) and must never be
# committed. This file contains no real credentials and is safe to commit.
#
# On Railway and in GitHub Actions, these same variable names are set as
# real environment variables / repository secrets — .env is never used on
# either platform (see src/backup/config.py's module docstring for the
# full three-source precedence explanation).

# ── football-data.org / API-Football (pick generation, settlement) ────────
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
API_FOOTBALL_BASE=

# ── GitHub Contents API (Railway sync, settlement, backup) ─────────────────
GITHUB_TOKEN=
GITHUB_OWNER=jorgepita
GITHUB_REPO=apostas-over-futebol
GITHUB_BRANCH=main

# ── Telegram (pick notifications) ───────────────────────────────────────────
TELEGRAM_TOKEN=
CHAT_ID=

# ── Cloudflare R2 (backup archive — Phase 27.2/27.3, see ADR-020) ──────────
# R2_ENABLED must be exactly "true" for the backup subsystem to do anything
# beyond logging "not configured" — every entry point fails closed
# otherwise. All four values below R2_BUCKET_NAME are optional; each has a
# documented default (see src/backup/config.py) and only needs to be set to
# override that default.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_CONNECT_TIMEOUT_SECONDS=10
R2_READ_TIMEOUT_SECONDS=60
R2_MAX_RETRY_ATTEMPTS=3

# ── Misc ─────────────────────────────────────────────────────────────────
UPDATE_RESULTS_DEBUG=
